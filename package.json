{
  "name": "@jr200-labs/xstate-nats",
  "version": "0.10.3",
  "description": "XState machine for NATS",
  "license": "MIT",
  "author": "Jayshan Raghunandan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jr200-labs/xstate-nats.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write \"**/*.{ts,mjs,js,json,md,yml,yaml}\"",
    "lint": "tsc --noEmit",
    "demo:dev": "vite --config docs/demo/vite.config.ts",
    "demo:build": "tsc -p docs/demo/tsconfig.json && vite build --config docs/demo/vite.config.ts",
    "demo:test": "vitest run --config docs/demo/vitest.config.ts",
    "docs:preview": "quarto preview docs",
    "docs:build": "quarto render docs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "xstate",
    "nats",
    "state-machine",
    "websocket"
  ],
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/obj": "^3.4.0",
    "xstate": "^5.33.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
